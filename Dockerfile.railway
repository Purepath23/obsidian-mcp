# Combined container for Railway: obsidian-headless sync + obsidian-mcp
# Uses a simple bash entrypoint to supervise both processes.

FROM node:22-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts && npm install --no-save --ignore-scripts @modelcontextprotocol/sdk@1.24.3
COPY . .
RUN npm run build

FROM node:22-slim

# Install pinned obsidian-headless CLI. Do not use --ignore-scripts here:
# transitive native dependencies may need install/build steps.
RUN npm install -g obsidian-headless@0.0.10 && npm cache clean --force

# Copy built MCP server
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY package.json .

# Create vault directory
RUN mkdir -p /vault
ENV XDG_CONFIG_HOME=/vault/.config

# Startup script: login, setup, sync in background, then start MCP server
COPY <<'ENTRYPOINT' /app/start.sh
#!/bin/bash
set -e

: "${OBSIDIAN_EMAIL:?Missing OBSIDIAN_EMAIL}"
: "${OBSIDIAN_PASSWORD:?Missing OBSIDIAN_PASSWORD}"
: "${VAULT_NAME:?Missing VAULT_NAME}"
: "${VAULT_PASSWORD:?Missing VAULT_PASSWORD}"
: "${AUTH_TOKEN:?Missing AUTH_TOKEN}"
# Keep the MCP API available from the persistent vault even if Obsidian's
# auth/sync service is temporarily rate-limited or a prior deploy holds a lock.
echo "[init] Starting protected MCP API..."
cd /app
node dist/index.js &
MCP_PID=$!

sync_loop() {
  while true; do
    echo "[sync] Checking saved Obsidian login..."
    if ! ob sync-list-remote --json >/dev/null 2>&1; then
      if ! ob login --email "$OBSIDIAN_EMAIL" --password "$OBSIDIAN_PASSWORD"; then
        echo "[sync] Login temporarily unavailable; retrying in 120 seconds"
        sleep 120
        continue
      fi
    fi
    if [ ! -f /vault/.railway-vault-configured ]; then
      echo "[sync] Configuring encrypted vault..."
      if ob sync-setup --vault "$VAULT_NAME" --path /vault --password "$VAULT_PASSWORD" --device-name "Railway Second Brain"; then
        touch /vault/.railway-vault-configured
      else
        echo "[sync] Setup unavailable; retrying in 120 seconds"
        sleep 120
        continue
      fi
    fi
    echo "[sync] Starting continuous sync..."
    if ! ob sync --path /vault --continuous; then
      echo "[sync] Sync unavailable or lock held by previous deployment; retrying in 120 seconds"
    fi
    sleep 120
  done
}
sync_loop &
SYNC_PID=$!

trap 'kill "$SYNC_PID" "$MCP_PID" 2>/dev/null || true; exit 0' SIGTERM SIGINT
wait "$MCP_PID"
echo "[error] MCP API stopped."
kill "$SYNC_PID" 2>/dev/null || true
exit 1
ENTRYPOINT
RUN chmod +x /app/start.sh

ENV VAULT_PATH=/vault
ENV PORT=3456
ENV BIND_ADDRESS=0.0.0.0
EXPOSE 3456

CMD ["/app/start.sh"]
