# Combined container for Railway: obsidian-headless sync + obsidian-mcp
# Uses a simple bash entrypoint to supervise both processes.

FROM node:22-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build

FROM node:22-slim

# Install pinned obsidian-headless CLI. Do not use --ignore-scripts here:
# transitive native dependencies may need install/build steps.
RUN npm install -g obsidian-headless@0.0.10 && npm cache clean --force

# Copy built MCP server
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY package.json .

# Create vault directory
RUN mkdir -p /vault
ENV XDG_CONFIG_HOME=/vault/.config

# Startup script: login, setup, sync in background, then start MCP server
COPY <<'ENTRYPOINT' /app/start.sh
#!/bin/bash
set -e

: "${OBSIDIAN_EMAIL:?Missing OBSIDIAN_EMAIL}"
: "${OBSIDIAN_PASSWORD:?Missing OBSIDIAN_PASSWORD}"
: "${VAULT_NAME:?Missing VAULT_NAME}"
: "${VAULT_PASSWORD:?Missing VAULT_PASSWORD}"
: "${AUTH_TOKEN:?Missing AUTH_TOKEN}"
echo "[init] Checking saved Obsidian login..."
if ! ob sync-list-remote --json >/dev/null 2>&1; then
  attempt=1
  until ob login --email "$OBSIDIAN_EMAIL" --password "$OBSIDIAN_PASSWORD"; do
    echo "[warn] Obsidian login unavailable; retry $attempt in 120 seconds"
    sleep 120
    attempt=$((attempt + 1))
  done
fi

echo "[init] Setting up vault: $VAULT_NAME"
cd /vault
if ob sync-status --path /vault --json >/dev/null 2>&1; then
  echo "[init] Existing vault configuration found"
else
  echo "[init] Configuring encrypted vault..."
  ob sync-setup --vault "$VAULT_NAME" --path /vault --password "$VAULT_PASSWORD" --device-name "Railway Second Brain"
fi

echo "[init] Initial sync before enabling MCP..."
ob sync --path /vault

echo "[init] Starting continuous sync..."
ob sync --path /vault --continuous &
SYNC_PID=$!

echo "[init] Starting obsidian-mcp server..."
cd /app
node dist/index.js &
MCP_PID=$!

# If either process exits, kill the other and exit
trap "kill $SYNC_PID $MCP_PID 2>/dev/null; exit 1" SIGTERM SIGINT
wait -n $SYNC_PID $MCP_PID
echo "[error] A process exited unexpectedly, shutting down..."
kill $SYNC_PID $MCP_PID 2>/dev/null
exit 1
ENTRYPOINT
RUN chmod +x /app/start.sh

ENV VAULT_PATH=/vault
ENV PORT=3456
ENV BIND_ADDRESS=0.0.0.0
EXPOSE 3456

CMD ["/app/start.sh"]
